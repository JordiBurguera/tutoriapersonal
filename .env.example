PORT=3000
# URL pública: se usa en los enlaces de los correos. Con https la cookie se marca Secure.
APP_URL=http://localhost:3000
# Primera cuenta de administrador (solo la parte antes de @lescarolines.com)
ADMIN_USER=jordi.burguera
# Gmail: smtp.gmail.com:465. SMTP_PASS es una "contraseña de aplicación" de Google, no la de la cuenta.
# Si faltan SMTP_USER o SMTP_PASS, el enlace de acceso se imprime en la consola (solo para desarrollo).
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Tutoría personal <tutoria@lescarolines.com>
DB_PATH=data/tutoria.db
# Hora (Europe/Madrid) del recordatorio diario al profesorado
REMINDER_HOUR=8
# TEMPORAL, solo para pruebas. Con 1, un usuario que contenga "prof", "alm" o "admn" y un número
# (prof1, alm1, admn1) entra sin correo de confirmación y, si no existía, se crea con ese nivel.
# Cualquiera podría entrar así, también como administrador: quítalo antes de abrir la aplicación a otras personas.
LOGIN_PRUEBA=1
